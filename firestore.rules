rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Helper functions
    function isSignedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return isSignedIn() && (
        (exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
         get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin') ||
        request.auth.token.email == 'onlyphone678@gmail.com'
      );
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    // Users Collection
    match /users/{userId} {
      allow read: if isSignedIn() && (isOwner(userId) || isAdmin());
      allow create: if isSignedIn() && isOwner(userId) && (
        !('role' in request.resource.data) ||
        request.resource.data.role == 'user' ||
        (request.resource.data.role == 'admin' && request.auth.token.email == 'onlyphone678@gmail.com')
      );
      allow update: if isSignedIn() && (
        isAdmin() ||
        (isOwner(userId) && (
          !('role' in request.resource.data) ||
          (resource == null && request.resource.data.role == 'user') ||
          (resource != null && 'role' in resource.data && request.resource.data.role == resource.data.role) ||
          (resource != null && !('role' in resource.data) && request.resource.data.role == 'user')
        ))
      );
      allow delete: if isAdmin();
    }

    // Sarip Profile Document
    match /sarip/{docId} {
      allow read: if isSignedIn() && (resource.data.uid == request.auth.uid || isAdmin());
      allow create: if isSignedIn() && request.resource.data.uid == request.auth.uid;
      allow update: if isSignedIn() &&
        resource.data.uid == request.auth.uid &&
        request.resource.data.uid == resource.data.uid;
      allow delete: if false;
    }

    // Usernames Collection (for uniqueness check)
    match /usernames/{username} {
      allow read: if true;
      allow create, delete: if isSignedIn();
    }

    // Projects Collection
    match /projects/{projectId} {
      allow read: if true;
      allow create, update, delete: if isAdmin();
    }

    // Services Collection
    match /services/{serviceId} {
      allow read: if true;
      allow create, update, delete: if isAdmin();
    }

    // Project Requests Collection
    match /project_requests/{requestId} {
      allow read: if isSignedIn() && (resource.data.userId == request.auth.uid || isAdmin());
      allow create: if true;
      allow update, delete: if isAdmin();
    }

    // Messages / Support Collection
    match /messages/{messageId} {
      allow read: if isAdmin() || (isSignedIn() && resource.data.userId == request.auth.uid);
      allow create: if true;
      allow update, delete: if isAdmin();
    }

    // Live Chat Collection & Messages Subcollection
    // Define ADMIN_UID constant (placeholder)
    function isChatAdmin() {
      return isSignedIn() && (
        request.auth.uid == 'ADMIN_UID' || isAdmin()
      );
    }

    match /chats/{userId} {
      allow read, write: if isSignedIn() && (request.auth.uid == userId || isChatAdmin());

      match /messages/{messageId} {
        allow read: if isSignedIn() && (request.auth.uid == userId || isChatAdmin());
        allow create: if isSignedIn() && (
          (request.auth.uid == userId && request.resource.data.senderId == request.auth.uid && request.resource.data.senderRole == 'user') ||
          (isChatAdmin() && request.resource.data.senderRole == 'admin')
        );
        allow update, delete: if false;
      }
    }
  }
}
